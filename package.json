{
  "name": "airgap-sync",
  "version": "0.1.0",
  "description": "Sync Git and npm dependencies for airgapped environments",
  "type": "module",
  "bin": {
    "airgap-sync": "dist/cli.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "support",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "benchmark:python-bundle": "node ./scripts/benchmark-python-bundle.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run knip",
    "cli": "node ./dist/cli.cjs",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "KNIP_DISABLE_RAW_TRANSFER=1 knip",
    "lint": "eslint .",
    "e2e:local": "node ./scripts/e2e-local.mjs",
    "e2e:ktransformers": "npm run build && node ./scripts/ktransformers-planner-e2e.mjs",
    "e2e:python-planner": "npm run build && node ./scripts/python-planner-e2e.mjs",
    "registry:start": "verdaccio --config ./verdaccio/config.yaml",
    "spike:python-planner": "node ./scripts/python-planner-spike.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "update:run": "node ./scripts/update-and-run.mjs"
  },
  "keywords": [
    "npm",
    "git",
    "gitea",
    "registry",
    "verdaccio",
    "airgap",
    "offline",
    "dependencies",
    "mirror",
    "seed"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hewabive/airgap-sync.git"
  },
  "bugs": {
    "url": "https://github.com/hewabive/airgap-sync/issues"
  },
  "homepage": "https://github.com/hewabive/airgap-sync#readme",
  "author": "hewabive",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.10.1",
  "dependencies": {
    "@renovatebot/pep440": "^5.0.0",
    "commander": "^14.0.2",
    "npm-package-arg": "^13.0.0",
    "semver": "^7.7.3",
    "smol-toml": "^1.7.0",
    "tar": "^7.5.22",
    "yaml": "^2.9.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^25.0.3",
    "@types/npm-package-arg": "^6.1.4",
    "@types/semver": "^7.7.1",
    "@types/yauzl": "^2.10.3",
    "eslint": "^9.39.2",
    "knip": "^6.29.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "verdaccio": "^6.7.1",
    "vitest": "^4.0.16"
  }
}
