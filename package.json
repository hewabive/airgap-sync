{
  "name": "airgap-sync",
  "version": "0.0.0",
  "description": "Sync Git and npm dependencies for airgapped environments",
  "type": "module",
  "bin": {
    "airgap-sync": "dist/cli.cjs"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "check": "pnpm lint && pnpm typecheck && pnpm test:run",
    "dev": "tsup --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "registry:start": "verdaccio --config ./verdaccio/config.yaml",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "npm",
    "git",
    "gitea",
    "registry",
    "verdaccio",
    "airgap",
    "offline",
    "dependencies",
    "mirror",
    "seed"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2",
    "fs-extra": "^11.3.3",
    "npm-package-arg": "^13.0.0",
    "p-limit": "^7.2.0",
    "semver": "^7.7.3",
    "tar": "^7.5.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.0.3",
    "@types/npm-package-arg": "^6.1.4",
    "@types/semver": "^7.7.1",
    "eslint": "^9.39.2",
    "prettier": "^3.7.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0",
    "verdaccio": "^6.7.1",
    "vitest": "^4.0.16"
  }
}
